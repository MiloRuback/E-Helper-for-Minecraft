{
  "name": "every-helper-minecraft",
  "version": "1.0.0",
  "description": "Every Helper for Minecraft — Aplicativo desktop multifuncional para jogadores de Minecraft",
  "main": "./out/main/index.js",
  "author": "Milo Ruback",
  "license": "MIT",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "package": "electron-vite build && electron-builder --win",
    "postinstall": "electron-builder install-app-deps"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "i18next": "^23.16.8",
    "react-i18next": "^15.1.3",
    "i18next-browser-languagedetector": "^8.0.2"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "electron-vite": "^2.3.0",
    "typescript": "^5.7.2",
    "vite": "^6.0.5"
  },
  "build": {
    "appId": "com.everyhelper.minecraft",
    "productName": "Every Helper for Minecraft",
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "Every Helper for Minecraft"
    },
    "publish": {
      "provider": "github",
      "owner": "rubac",
      "repo": "E-Helper-for-Minecraft"
    },
    "directories": {
      "output": "dist"
    }
  }
}
