{
  "name": "every-helper-for-minecraft",
  "version": "0.1.22",
  "description": "Desktop helper for Minecraft players with skins, blueprints, seed maps, worlds, modpacks and profile tools.",
  "author": "Milo Ruback",
  "private": true,
  "main": "dist-electron/main/main.js",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"npm:dev:renderer\" \"npm:dev:electron\"",
    "dev:renderer": "vite --host 127.0.0.1 --port 5173",
    "dev:electron": "wait-on tcp:5173 && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5173 electron .",
    "build": "npm run typecheck && vite build && tsc -p tsconfig.electron.json",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview --host 127.0.0.1 --port 4173",
    "start": "npm run build && electron .",
    "build:development": "cross-env VITE_APP_CHANNEL=development npm run build",
    "build:stable": "cross-env VITE_APP_CHANNEL=stable npm run build",
    "dist:development": "cross-env VITE_APP_CHANNEL=development npm run dist",
    "dist": "npm run build && electron-builder --win nsis --publish never",
    "dist:stable": "cross-env VITE_APP_CHANNEL=stable npm run dist",
    "dist:portable": "npm run build && electron-builder --win portable",
    "lint": "tsc --noEmit",
    "build:cubiomes": "powershell -ExecutionPolicy Bypass -File tools/cubiomes/build-cubiomes-wasm.ps1"
  },
  "dependencies": {
    "@taku128/java-schematic": "^0.2.3",
    "archiver": "^8.0.0",
    "electron-updater": "^6.8.9",
    "prismarine-nbt": "^2.8.0"
  },
  "devDependencies": {
    "@supabase/supabase-js": "^2.112.2",
    "@types/archiver": "^8.0.0",
    "@types/node": "^25.0.3",
    "@types/react": "^18.3.27",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^5.2.0",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "electron": "^43.3.0",
    "electron-builder": "^26.0.12",
    "lucide-react": "^0.561.0",
    "playwright": "^1.62.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "skinview3d": "^3.4.2",
    "three": "^0.181.2",
    "typescript": "^5.9.3",
    "vite": "^8.2.1",
    "wait-on": "^9.0.3"
  },
  "build": {
    "appId": "com.everyhelper.minecraft",
    "productName": "Every Helper for Minecraft",
    "compression": "maximum",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "assets/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.ico"
    },
    "publish": {
      "provider": "github",
      "owner": "MiloRuback",
      "repo": "E-Helper-for-Minecraft"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "Every Helper for Minecraft",
      "artifactName": "Every-Helper-for-Minecraft-Setup-${version}.${ext}"
    }
  }
}
